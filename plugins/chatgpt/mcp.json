{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "sncr": {
      "type": "streamable-http",
      "url": "https://api.voa.health/mcp/sncr/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "voa:sncr:read"
            ]
          }
        }
      }
    }
  }
}
